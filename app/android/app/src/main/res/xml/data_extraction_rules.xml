<?xml version="1.0" encoding="utf-8"?>
<!-- Backup e transferência para outro aparelho (Android 12+): as credenciais
     cifradas ficam de fora (ver backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
